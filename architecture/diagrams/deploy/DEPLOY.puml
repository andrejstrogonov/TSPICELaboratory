@startuml
skinparam monochrome true
skinparam shadowing false
skinparam componentStyle rectangle

title Топология развертывания и логирования системы "TSpice Laboratory E2E" с Sonatype Nexus

' Сервер сборки
node "Jenkins Build Server" as JenkinsNode <<Ubuntu/Debian Enterprise Server>> {
    artifact "Advanced Jenkins Pipeline\n(Fail-Fast Wrapper)" as Pipeline <<script>>
    component "Docker Engine (Build)" as JenkinsDocker <<subsystem>>
}

' Локальный менеджер артефактов Sonatype Nexus
node "Local Artifact Manager" as NexusNode <<Sonatype Nexus 3 Container>> {

    node "Docker Registry\n[TCP 8082]" as NexusDockerPort {
        database "Docker Hosted Registry" as DockerRepo {
            artifact "tspice-laboratory-e2e:1.0.0-${BUILD_NUMBER}" as AppImage <<Docker Image>>
        }
    }

    node "Web UI & REST API\n[TCP 8081]" as NexusRawPort {
        database "Raw Hosted Repository\n(pipeline-statuses)" as RawRepo {
            folder "tspice-laboratory-e2e / ${BUILD_NUMBER}" as StatusFolder {
                artifact "status-Checkout.txt" as Log1 <<plain text>>
                artifact "status-Build-Docker-Image.txt" as Log2 <<plain text>>
                artifact "status-Push-to-Nexus.txt" as Log3 <<plain text>>
                artifact "status-Deploy-to-Windows.txt" as Log4 <<plain text>>
                artifact "status-Verify-Deployment.txt" as Log5 <<plain text>>
                artifact "status-Health-Check.txt" as Log6 <<plain text>>
            }
        }
    }
}

' Целевой Windows GPU сервер
node "Windows GPU Server" as WindowsNode <<Windows Server Compute Node>> {

    node "Docker Engine Windows (with CUDA Isolation)" as WinDocker <<subsystem>> {
        node "Docker Container: tspice-laboratory-e2e" as Container <<container>> {
            component "FastAPI Python App" as App <<application>>
            component "Calculators & Solvers" as Solvers <<subsystem>>
            component "OpenVAF / OpenSpice Backends" as Compilers <<subsystem>>
        }
    }

    node "Hardware & Storage Layer" {
        node "NVIDIA GPU\n(GeForce RTX 4090)" as GPU <<hardware>>
        folder "Host Data Directory\n(Shared Volume)" as DataVol <<storage>>
    }
}

' --- Сетевые потоки и связи согласно новой стратегии ---

' 1. Инициализация и логирование шагов
Pipeline -down-> RawRepo : 1. Предварительная инициализация\n[HTTP curl / выгрузка NOT_STARTED логов]

' 2. Сборка и отправка образа
Pipeline --> JenkinsDocker : 2. Запуск сборки
JenkinsDocker -right-> DockerRepo : 3. Push Image [HTTP / TCP 8082]
Pipeline -down-> Log3 : Обновление статуса стейджа\n[SUCCESS / FAILURE с логом JVM]

' 3. Подключение по SSH и оркестрация деплоя
Pipeline -down-> WindowsNode : 4. SSH Команды деплоя\n[SSH / TCP 22 via sshagent]

' 4. Windows сервер забирает образ из локального репозитория
WinDocker .up.> DockerRepo : 5. Pull Image [HTTP / TCP 8082]

' 5. Внутренний маппинг и CUDA-акселерация
WinDocker *-down-> Container : Проводка и запуск
Container -down-> GPU : Сквозной доступ к CUDA\n[--gpus all]
Container .down.> DataVol : Хранение сессий SQLite\n[-v host.docker.internal/data]

' 6. Финальная верификация и Health Check
Pipeline -.-> App : 6. Проверка доступности\n[HTTP / TCP 8000 via Curl]
Pipeline -down-> Log6 : Фиксация финального статуса\n[SUCCESS или точный таймаут ошибки]

@endum


