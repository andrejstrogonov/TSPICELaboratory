@startuml ALGO_GRAPH_NN
' =====================================================================
' A-8 · Graph Neural Network суррогат: меш → граф → GNN → поля/токи → warm start
' Проектируемый компонент (в коде — TODO: src/neural_physics.py
'   «TODO: Добавить Graph Networks измерить все на метриках»;
'   зависимости torch-geometric и torchmetrics уже в requirements.txt)
' Целевые показатели: models_requirements.md (ФТ.5.1–5.4, НФТ.5.1–5.4)
' =====================================================================
!theme plain
skinparam monochrome true
skinparam shadowing false
skinparam ArrowFontSize 10

title A-8 · Алгоритм Graph NN суррогата для ускоренного расчёта характеристик

start

:Вход: структура (geometry_data) + рабочая точка (Vg, Vd, T) ;

partition "G1 · Графовое кодирование меша / геометрии" {
  :Узлы V = узлы тетраэдральной сетки ИЛИ\nпараметрические контрольные точки структуры;
  :Признаки узла h_i⁰ ∈ ℝ^d:
    · координаты (x, y, z) / нормированные габариты
    · материал (one-hot: тело / оксид / BOX / барьер / металл)
    · локальные ε_r, μ, N_D⁺, N_A⁻
    · тип границы (Дирихле / Робен / Нейман) и потенциал контакта;
  :Рёбра E: вершины тетраэдров (меш-граф)\nили k-NN по расстоянию (геометрия без меша);
  :Признаки ребра e_ij: длина, проводимость перехода g_ij = ε_ij·A_ij/d_ij;
  :Глобальный контекст u: (Vg, Vd, Vb, T, рабочий режим, семейство приборов);
  :Нормализация: log10 легирования, масштабирование напряжений по VDD.
}

partition "G2 · Архитектура графовой сети" {
  :Message Passing × L слоёв (по умолчанию L = 4…8):
    m_ij = MLP_msg(h_i, h_j, e_ij, u)
    h_i' = MLP_upd(h_i, Σ_{j∈N(i)} m_ij, u);
  :Реализация на torch-geometric:
    · GCNConv        — быстрый baseline (спектральное приближение)
    · GraphSAGE      — индуктивность на новых геометриях
    · GAT            — внимание на важных переходах (затвор / канал)
    · GraphTransformer — для крупных иерархических структур;
  :Декодеры (heads):
    · феликсный head: ψ, n, p, T по узлам → h_i^out
    · интегральный head: edge-pooling → I_d, Q_g, Q_d, Q_s
      (permutation-invariant readout: sum / mean / attention-pool);
  :Нормировки: LayerNorm + residual; активации tanh/SiLU (C∞-гладкость).
}

partition "G3 · Физически-информированная функция потерь" {
  :L_total = α·L_data + β·L_poisson + γ·L_continuity + δ·L_BC + ζ·L_charge;
  :L_data       = MSE(pred, FEM/измерение) на узлах;
  :L_poisson    = mean ‖ Δψ_k + q/ε_k (n_k − p_k − N_D⁺ + N_A⁻) ‖²;
  :L_continuity = mean ‖ ∂n/∂t − (1/q)∇·J_n + R(n,p) ‖²   (R = SRH + Auger);
  :L_BC         = MSE на границах Дирихле / Робена затвора;
  :L_charge     = ‖ Σ Q_i(V) ‖²  (зарядовая нейтральность, Уорд–Даттон);
  :Веса α,β,γ,δ,ζ — нормировка по масштабу каждого члена (Тихонов-регуляризация).
}

partition "G4 · Обучение и активное обучение (ФТ.5.4)" {
  :AdamW + cosine scheduler, AMP на CUDA;
  repeat
    :Мини-батч графов (структура + рабочая точка);
    :Forward MP → losses → backward (автоматическое дифференцирование по графу);
    :Uncertainty estimation (MC-dropout / ensemble / GP-head);
    if (неуверенность > порог\nв области параметров?) then (да)
      :Запуск точного FEM (или quantum-Poisson) в этой точке;
      :Пополнение буфера + on-line fine-tune\nбез остановки симуляции;
    endif
  repeat while (не достигнут критерий:\nval RMSE_rel ≤ 1.0 % и L_phys ≤ ε?)
  :Реестр surrogate_models + training_runs + training_samples.
}

partition "G5 · Инференс в цикле характеристик" {
  :Батч рабочих точек (Vg × Vd × T) → граф-контекст u;
  :forward pass (O(1) по числу узлов меша, один проход);
  :Выход: карты ψ, n, p, T + интегральные I_d, Q_g;
  :Якобиан для Ньютона-Рафсона:
    ∂I/∂V = автодифференцирование по входным напряжениям
    (backprop по графу вычислений, а не численная разность);
  :Проверки качества (НФТ.5.2):
    · монотонность ВАХ на сетке Vg
    · C²-непрерывность (контроль 2-й производной)
    · отсутствие ложных локальных экстремумов.
}

partition "G6 · Гибридное сопряжение с физическим решателем" {
  :Warm start: ψ₀, n₀, p₀ из GNN → Newton/FEM доводка (3–5 итераций);
  :Export ONNX (opset 17) → Rust ort::Session\nили TensorRT/ONNX Runtime с FP16/INT8;
  :Логирование эффективности:
    neural_runs(warm_start_residual, iters_saved, uncertainty,
                fallback_to_fem);
  if (физическая невязка после доводки > допуска?) then (да)
    :Отметка «суррогат непригоден в этой зоне»;
    :Принудительный прямой FEM-расчёт;
  else (нет)
    :Результат принимается; метрики пишутся в curve_metrics_values;
  endif
  stop
}

legend bottom
  Преимущество перед U-Net: граф не требует регулярной сетки —
  работает на тетраэдральном меше, на CAD-геометрии и на разных
  семействах приборов одной моделью.
  ФТ.5.2: ошибка нарушения непрерывности и сохранения заряда
  на границах раздела ≤ 1e-5.
  НФТ.5.1: ускорение относительно FEM — 1e4…1e5 раз.
endlegend

@enduml
